{
  "Kafka": {
    "DeviceInfo": {
      "BootstrapServers": "100.64.0.13:9092",
      "Topic": "jdx-topic.hardware.device_info",
      "Acks": "all",
      "EnableIdempotence": true,
      "CompressionType": "lz4",
      "MaxInFlight": 5,
      "RetryAttempts": 3,
      "RetryBackoffMs": 1000,
      "IntervalMinutes": 60,
      "MaxCpuPercent": 85,
      "MaxDeferMinutes": 10,
      "DeviceInfoPath": "C:\\deviceinfo\\deviceinfo.txt"
    }
  }
}
